DirectoryIndex index.php index.html

RewriteEngine On
RewriteBase /

# Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Redirect old .html requests to .php with 301 Permanent Redirect for SEO
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /([^\ ]+)\.html
RewriteRule ^/?(.*)\.html$ /$1.php [L,R=301]

# Panel & Admin Aliases
RewriteRule ^(admin|yonetim|panel)/?$ panel.php [L,QSA]

# API Routing
RewriteRule ^api/therapists/?$ php_app/api/therapists.php [L,QSA]
RewriteRule ^api/analytics/?$ php_app/api/analytics.php [L,QSA]
